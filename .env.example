# Server Configuration
PORT=3000
NODE_ENV=development
VITE_BACKEND_URL=

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
# Encrypts bank keys, alert tokens and tax documents. Empty falls back to JWT_SECRET. Set once, never change.
ENCRYPTION_SECRET=your_encryption_secret_here
BCRYPT_ROUNDS=10
SESSION_DURATION_MS=604800000

# Self-registration. Set to false to refuse new sign-ups (existing users are unaffected).
ALLOW_REGISTRATION=true

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=crystal

# External Integrations
ENABLE_BANKING_API=
ENABLE_BANKING_REDIRECT_URL=
CORS_ORIGIN=

# Alerts sent from the server (ntfy, Gotify or a webhook). Each user sets their own destination on Connections.
# Set to false to switch the scheduler off.
ALERTS_ENABLED=true
# How often the server checks everyone's data, in minutes (minimum 5).
ALERTS_INTERVAL_MINUTES=30
# Allow alert destinations on your own network (a self-hosted ntfy or Gotify). Leave false if other people use this server.
ALERTS_ALLOW_PRIVATE_URLS=false

# Ask Crystal: questions about your money in plain words, answered by a language model.
# The built-in engine is the optional `ollama` container (docker compose --profile ai up -d). OLLAMA_URL is where the
# backend finds it; the default suits the bundled docker-compose.yml.
OLLAMA_URL=http://ollama:11434
# Ask Crystal can also use a model server you already run, from Settings, Connections. An address on your own network
# is always allowed when you are the only user. Set this to true to allow it when other people share the server.
ASSISTANT_ALLOW_PRIVATE_URLS=false

# Tax pack documents: encrypted files kept on the server's disk (not in the database). Back this folder up with the database.
# The default sits inside the backend's /app/config volume. Limits are in megabytes.
TAX_DOCS_DIR=
TAX_DOC_MAX_MB=10
TAX_DOC_USER_MAX_MB=500

# Enable Banking: the callback address registered in the Enable Banking control panel, for example
# https://crystal.example.com/enable-banking/callback  (https only, except localhost)
# ENABLE_BANKING_REDIRECT_URL=
